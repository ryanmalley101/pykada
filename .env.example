# Copy this file to .env and replace the placeholders. .env is gitignored.
#
# pykada loads .env with override=True, so values here take precedence over
# variables already set in your shell.

# Required: API key from Verkada Command, used by every client created
# without an explicit api_key (and by the functional wrappers).
VERKADA_API_KEY="your-verkada-api-key"

# Optional below: IDs used only by the live smoke scripts in
# pykada/*/testbed/. Leave a placeholder for any you don't run.

# A second API key for cameras_tests/testbed/testbed_oop.py (OOP-style run)
SECONDARY_API_KEY="your-secondary-verkada-api-key"

# Your organization ID (StreamingClient playlist URLs)
ORG_ID="your-org-id"

# Cameras testbeds
CAMERA_ID="your-camera-id"
LPR_CAMERA_ID="your-lpr-enabled-camera-id"
OCCUPANCY_TRENDS_DASHBOARD_ID="your-operational-dashboard-id"

# Access control testbed: an API-enabled door. Commented out so the testbed
# uses the first API-enabled door it finds; uncomment to pick one.
# DOOR_ID="your-api-enabled-door-id"

# Sensors testbed
SENSOR_ID="your-sensor-device-id"

# Workplace testbed: a Guest site. Commented out so the testbed uses the
# first Guest site it finds; uncomment to pick one.
# GUEST_SITE_ID="your-guest-site-id"

# Classic alarms testbed
CLASSIC_ALARMS_SITE_ID="your-classic-alarms-site-id"
